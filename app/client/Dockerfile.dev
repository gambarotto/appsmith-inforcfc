# Dockerfile de Desenvolvimento - Frontend React

FROM node:20-alpine

LABEL maintainer="Appsmith Dev Team"
LABEL description="Frontend React para desenvolvimento"

# Instalar dependências do sistema
RUN apk add --no-cache \
    curl \
    bash \
    git

# Habilitar Corepack para Yarn 3.x
RUN corepack enable

# Criar diretório de trabalho
WORKDIR /app

# Copiar tudo (Yarn Workspaces precisa de todos os packages)
# .dockerignore vai excluir node_modules, build, etc
COPY . .

# Instalar dependências do workspace
RUN yarn install

# Porta do dev server
EXPOSE 3000

# Script de inicialização
COPY docker-entrypoint-dev.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-dev.sh

ENTRYPOINT ["docker-entrypoint-dev.sh"]

