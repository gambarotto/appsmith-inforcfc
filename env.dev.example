# Variáveis de Ambiente para Desenvolvimento com Docker
# Copie este arquivo para .env.dev e ajuste conforme necessário

# ============================================================================
# Segurança
# ============================================================================
APPSMITH_ENCRYPTION_PASSWORD=dev_password_change_in_production
APPSMITH_ENCRYPTION_SALT=dev_salt_change_in_production

# ============================================================================
# Configurações Gerais
# ============================================================================
APPSMITH_IS_SELF_HOSTED=false
APPSMITH_LOG_LEVEL=info

# ============================================================================
# Portas Expostas (host:container)
# ============================================================================
# MongoDB: 27017:27017
# Redis: 6379:6379
# Backend: 8080:8080
# Backend Debug: 5005:5005
# RTS: 8091:8091
# Frontend: 3000:3000
# Nginx: 80:80

# ============================================================================
# URLs dos Serviços (interno aos containers)
# ============================================================================
# MongoDB: mongodb://mongodb:27017/appsmith
# Redis: redis://redis:6379
# Backend: http://backend:8080
# RTS: http://rts:8091
# Frontend: http://frontend:3000

